# PII Shield Database MCP Server Configuration

# Database Credentials
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_secure_password
PGDATABASE=your_database_name

# Active Regex Scan Name Roster File Path
ROSTER_PATH=./entityRoster.json

# Pseudonymized Tokens In-Memory Cache TTL in seconds (default: 30 minutes)
CACHE_TTL_SEC=1800

# Remote SSE Transport Settings (Used only when --sse flag is passed)
PORT=3000
TRANSPORT=sse
MCP_API_KEY=your_generated_random_hex_api_key
